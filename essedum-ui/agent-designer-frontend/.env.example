# AgentFlow Designer - Environment Variables Example
# Copy this file to .env and fill in your values
# For local overrides, copy to .env.local (never commit .env.local)

# ─── App Identity ─────────────────────────────────────────────────────────────
# Display name shown in browser tab and app header
VITE_APP_TITLE=AgentFlow Designer

# Semantic version of the application
VITE_APP_VERSION=1.0.0

# ─── Dev Server ───────────────────────────────────────────────────────────────
# Port the Vite dev server listens on (default: 4000)
VITE_PORT=4000

# ─── Backend API ──────────────────────────────────────────────────────────────
# Base URL of the AgentFlow Designer backend
# Used both by the browser (API calls) and Vite dev proxy
# Example: http://localhost:4545  |  https://api.yourcompany.com
VITE_API_BASE_URL=http://localhost:4545

# ─── Authentication ───────────────────────────────────────────────────────────
# Authentication provider to use
# Options: none | azure-ad | okta | auth0
VITE_AUTH_PROVIDER=none

# ─── Environment ──────────────────────────────────────────────────────────────
# Runtime environment label (used for logging / feature flags)
# Options: development | staging | production
VITE_ENVIRONMENT=development
