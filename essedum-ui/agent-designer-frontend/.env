# AgentFlow Designer — Environment Variables
# Copy this file to .env.local for local overrides (never commit .env.local)

# App identity
VITE_APP_TITLE=AgentFlow Designer
VITE_APP_VERSION=1.0.0

# Backend API (leave empty to run fully client-side)
VITE_API_BASE_URL=

# Authentication provider: none | azure-ad | okta | auth0
VITE_AUTH_PROVIDER=none

# Optional: override the login page illustration
# VITE_LOGIN_IMAGE_URL=https://your-cdn.com/login-illustration.svg

# Environment: development | staging | production
VITE_ENVIRONMENT=development
